{
  "version": 2,
  "name": "station-offline-recovery",
  "initial": {
    "connectivity": "online",
    "trackPower": true
  },
  "steps": [
    {
      "at": "1s",
      "action": "station.connectivity",
      "connectivity": "degraded"
    },
    {
      "at": "2s",
      "action": "station.connectivity",
      "connectivity": "offline"
    },
    {
      "at": "3s",
      "action": "station.connectivity",
      "connectivity": "online"
    }
  ]
}
