{
  "version": 2,
  "name": "benchmark-feedback-loss-and-resync",
  "initial": {"connectivity": "online", "trackPower": true},
  "steps": [
    {"at": "2m", "action": "feedback.set", "source": "simulator", "kind": "occupancy", "address": 1, "active": true, "emit": false},
    {"at": "2m1s", "action": "feedback.emit", "source": "simulator", "kind": "occupancy", "address": 2, "active": true},
    {"at": "2m2s", "action": "feedback.emit", "source": "simulator", "kind": "occupancy", "address": 1, "active": true}
  ]
}
