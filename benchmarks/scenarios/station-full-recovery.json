{
  "version": 2,
  "name": "benchmark-station-full-recovery",
  "initial": {"connectivity": "online", "trackPower": true},
  "steps": [
    {"at": "1m", "action": "fault.operation", "operation": "throttle", "delay": "100ms"},
    {"at": "1m", "action": "fault.operation", "operation": "function", "delay": "100ms"},
    {"at": "1m", "action": "fault.operation", "operation": "accessory", "delay": "100ms"},
    {"at": "2m", "action": "fault.clear"},
    {"at": "2m", "action": "fault.operation", "operation": "throttle", "delay": "500ms"},
    {"at": "2m", "action": "fault.operation", "operation": "function", "delay": "500ms"},
    {"at": "2m", "action": "fault.operation", "operation": "accessory", "delay": "500ms"},
    {"at": "3m", "action": "fault.clear"},
    {"at": "3m", "action": "station.connectivity", "connectivity": "degraded"},
    {"at": "4m", "action": "station.connectivity", "connectivity": "offline"},
    {"at": "5m", "action": "station.connectivity", "connectivity": "online"}
  ]
}
