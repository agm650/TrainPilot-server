{
  "http": { "listen": "0.0.0.0:8443", "tlsCert": "/etc/dccd/tls/server.crt", "tlsKey": "/etc/dccd/tls/server.key" },
  "admin": { "socket": "/run/dccd/admin.sock", "mode": 432 },
  "database": { "path": "/var/lib/dccd/dcc-control.db" },
  "station": { "driver": "simulator", "address": "127.0.0.1", "port": 21105, "transport": "tcp", "offlineAfter": "10s" },
  "security": { "accessTokenTTL": "15m", "refreshTokenTTL": "720h" },
  "control": { "leaseTTL": "10m", "stopGrace": "2s", "monitorPeriod": "250ms" },
  "testAPI": false,
  "seedDemo": false
}
